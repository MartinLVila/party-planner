{
  "name": "party-planner",
  "version": "0.1.0",
  "private": true,
  "description": "Plan AION 2 party builds and raid order with friends",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
